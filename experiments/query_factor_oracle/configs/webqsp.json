    "max_tokens": 4000,
    "seed": 0,
    "temperature": 0.0,
    "frequency_penalty": 0.14
  },
  "evaluator": {
    "hit": "reason/metrics/evaluate_results.py",
    "hit_at_1_and_f1": "reason/metrics/evaluate_results_corrected.py",
    "subsets": ["full", "answer_in_candidate_graph"],
    "score_h": "disabled_for_variants_due_to_upstream_hard_coded_retrieval_path"
  },
  "phase0": {
    "minimum_raw_output_agreement": 0.99,
    "minimum_parsed_answer_agreement": 1.0
  },
  "phase2": {
    "budgets": [50, 100, 200, 500],
    "diagnostics_top_k": 100,
    "match_state_limit": 100000
  },
